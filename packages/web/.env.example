# Tell Web — environment example. Copy to .env and fill what you use.
# Server reads: PORT (or --port), TELL_MODEL (or -m), TELL_TOKEN, vendor keys.

# Server
PORT="3000"
TELL_MODEL="d"
# Opt-in API auth: when set, /api/* (except /api/config) requires
# `Authorization: Bearer <token>` and the terminal WS requires ?token=<token>.
TELL_TOKEN=""

# Model vendor keys (only the vendors you use). Aliases live in src/ai/models.
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
XAI_API_KEY=""
DEEPSEEK_API_KEY=""
FIREWORKS_API_KEY=""
CEREBRAS_API_KEY=""
OPENROUTER_API_KEY=""
MOONSHOTAI_API_KEY=""

Note: @types/ws@8.18.1 is the latest release of types for ws 8.x
# (covers ws@8.21.3; there is no @types/ws 8.21.x).